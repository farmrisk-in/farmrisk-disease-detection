# Hugging Face Model ID or local directory
MODEL_ID=vegadurmin/crop-disease-deit-small

# Knowledge Base Directory (default: ./kb)
KB_DIR=./kb

# Google Gemini API Key for dynamic advisory generation & grounding
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Fill mode for missing KB sections: 'ai' | 'search' | 'auto' | 'off'
FILL_MODE=ai

# Hugging Face token (only required if MODEL_ID is a private repo)
# HF_TOKEN=your_hf_token_here

# Server configuration
HOST=0.0.0.0
PORT=7860
